#**************************************************************************************************
#
#   Wuxing Skills - Makefile for Android APK building
#   Adapted from raylib Makefile.Android template
#
#**************************************************************************************************

# Define required raylib variables
PLATFORM               ?= PLATFORM_ANDROID
RAYLIB_PATH             = build/_deps/raylib-src
ENET_PATH               = build/_deps/enet-src

# Vulkan Backend Switch (make USE_VULKAN=1 to enable)
# WARNING same class of landmine as ANDROID_NOTICES.md §D2's other raylib-flag changes:
# compile_raylib_android skips rebuilding raylib.a if it already exists at the target path.
# Toggling USE_VULKAN after a prior build reuses the STALE (wrong-backend) archive silently.
# Always `rm -rf android.wuxing_skills/raylib_build android.wuxing_skills/lib/*/libraylib.a`
# when flipping this flag.
USE_VULKAN             ?= 0

# Android architecture and API version
ANDROID_ARCH           ?= ARM64
ANDROID_API_VERSION     = 31

# Android SDK/NDK paths (macOS)
ANDROID_HOME           ?= $(HOME)/Library/Android/sdk
ANDROID_NDK            ?= $(ANDROID_HOME)/ndk/28.2.13676358
ANDROID_TOOLCHAIN       = $(ANDROID_NDK)/toolchains/llvm/prebuilt/darwin-x86_64
ANDROID_BUILD_TOOLS    ?= $(ANDROID_HOME)/build-tools/35.0.0
ANDROID_PLATFORM_TOOLS  = $(ANDROID_HOME)/platform-tools

# Java
JAVA_HOME              ?= /usr/local/opt/openjdk@17

ifeq ($(ANDROID_ARCH),ARM)
    ANDROID_ARCH_NAME   = armeabi-v7a
    ANDROID_SYSROOT_TRIPLE = arm-linux-androideabi
endif
ifeq ($(ANDROID_ARCH),ARM64)
    ANDROID_ARCH_NAME   = arm64-v8a
    ANDROID_SYSROOT_TRIPLE = aarch64-linux-android
endif

# Project configuration
PROJECT_NAME           ?= wuxing_skills
PROJECT_LIBRARY_NAME   ?= main
PROJECT_BUILD_ID       ?= android
PROJECT_BUILD_PATH     ?= $(PROJECT_BUILD_ID).$(PROJECT_NAME)
PROJECT_RESOURCES_PATH ?= resources
PROJECT_SOURCE_FILES   := main.c \
                          environment/environment_system.c \
                          environment/env_shadow.c \
                          core/map_manager.c \
                          core/resource_manager.c \
                          core/color_gradient.c \
                          core/float_curve.c \
                          core/skill_curve.c \
                          core/tuning.c \
                          core/emitter_system.c \
                          core/uv/flow_map.c \
                          core/uv/uv_deform.c \
                          core/uv/surface_flow.c \
                          core/force_field.c \
                          core/camera_fx.c \
                          core/particles/particle_system.c \
                          core/particles/gpu/particle_gpu_backend.c \
                          core/path_spline.c \
                          core/post_fx.c \
                          core/ribbon_strip.c \
                          core/screen_distort.c \
                          core/skill_manager.c \
                          core/sprite_anim.c \
                          core/trails/trail_system.c \
                          core/utils_math.c \
                          core/vfx_light.c \
                          core/decals/decal_system.c \
                          core/geometry/procedural_mesh_utils.c \
                          core/geometry/mesh_cache.c \
                          core/material/material_system.c \
                          core/composition/visual_composer.c \
                          core/presets/vfx_presets.c \
                          core/vfx_proc_ray.c \
                          core/afterimage.c \
                          core/time_fx.c \
                          core/motion_controller.c \
                          core/status_vfx.c \
                          core/skill_helper.c \
                          core/shader_preprocessor.c \
                          core/metaball_fx.c \
                          core/mesh_adjacency.c \
                          entities/entities.c \
                          sandbox/sandbox_core.c \
                          sandbox/ui_panel.c \
                          sandbox/vfx_test.c \
                          sandbox/skill_debugger.c \
                          sandbox/auto_test.c \
                          sandbox/visual_verify.c \
                          sandbox/pool_stats.c \
                          core/atmosphere.c \
                          core/audio_system.c \
                          core/debug_draw.c \
                          core/surface_material.c \
                          core/gfx_quality.c \
                          $(wildcard ai/*.c) \
                          $(wildcard boss/*.c) \
                          $(wildcard combat/*.c) \
                          $(wildcard control/*.c) \
                          $(wildcard character/*.c) \
                          $(wildcard formations/*.c) \
                          $(wildcard game/*.c) \
                          $(wildcard ui/*.c) \
                          net/net.c \
                          net/net_transport.c \
                          net/net_eos_stub.c \
                          $(wildcard $(ENET_PATH)/*.c) \
                          $(wildcard skills/*/*/*.c) \
                          $(wildcard skills/*/*/*/*.c) \
                          $(wildcard maps/*/*.c) \
                          $(wildcard maps/*/*/*.c)

ifeq ($(USE_VULKAN), 1)
    PROJECT_SOURCE_FILES += core/vulkan/wuxing_vulkan.c
endif

PROJECT_SOURCE_FILES   := $(sort $(PROJECT_SOURCE_FILES))

NATIVE_APP_GLUE_PATH    = $(ANDROID_NDK)/sources/android/native_app_glue

# App configuration
APP_LABEL_NAME         ?= WuxingSkills
APP_COMPANY_NAME       ?= mth2610
APP_PRODUCT_NAME       ?= wuxing
APP_VERSION_CODE       ?= 1
APP_VERSION_NAME       ?= 1.0
APP_ICON_LDPI          ?= $(RAYLIB_PATH)/logo/raylib_36x36.png
APP_ICON_MDPI          ?= $(RAYLIB_PATH)/logo/raylib_48x48.png
APP_ICON_HDPI          ?= $(RAYLIB_PATH)/logo/raylib_72x72.png
APP_SCREEN_ORIENTATION ?= landscape
APP_KEYSTORE_PASS      ?= wuxing123

# Library type: STATIC
RAYLIB_LIBTYPE         ?= STATIC
RAYLIB_LIB_PATH         = $(RAYLIB_PATH)/src

# Compiler and archiver
ifeq ($(ANDROID_ARCH),ARM)
    CC = $(ANDROID_TOOLCHAIN)/bin/armv7a-linux-androideabi$(ANDROID_API_VERSION)-clang
    AR = $(ANDROID_TOOLCHAIN)/bin/arm-linux-androideabi-ar
endif
ifeq ($(ANDROID_ARCH),ARM64)
    CC = $(ANDROID_TOOLCHAIN)/bin/aarch64-linux-android$(ANDROID_API_VERSION)-clang
    AR = $(ANDROID_TOOLCHAIN)/bin/aarch64-linux-android-ar
endif

# Compiler flags
ifeq ($(ANDROID_ARCH),ARM)
    CFLAGS = -std=c99 -march=armv7-a -mfloat-abi=softfp -mfpu=vfpv3-d16
endif
ifeq ($(ANDROID_ARCH),ARM64)
    CFLAGS = -std=c99 -mfix-cortex-a53-835769
endif
CFLAGS += -ffunction-sections -funwind-tables -fstack-protector-strong -fPIC
CFLAGS += -Wall -Wa,--noexecstack -Wformat -Werror=format-security -no-canonical-prefixes
CFLAGS += -DANDROID -DPLATFORM_ANDROID
CFLAGS += -O2

ifeq ($(USE_VULKAN), 1)
    # WUXING_USE_VULKAN: this project's own switch (core/vulkan/wuxing_vulkan.c's guard).
    # GRAPHICS_API_VULKAN: the macro scripts/rlvk_patch_raylib.py's #if guards actually check
    # inside the patched raylib source (rcore.c / rcore_android.c) - same name the desktop
    # CMake build defines (CMakeLists.txt: add_compile_definitions(GRAPHICS_API_VULKAN)).
    # Missing this second define would silently build the GL path even with the patch applied.
    # VK_USE_PLATFORM_ANDROID_KHR: must be visible before vulkan.h's first include (from rlvk.h,
    # itself included very early in rcore.c) so vkCreateAndroidSurfaceKHR/
    # VkAndroidSurfaceCreateInfoKHR get declared - a compiler flag is the only place early enough.
    CFLAGS += -DWUXING_USE_VULKAN -DGRAPHICS_API_VULKAN -DVK_USE_PLATFORM_ANDROID_KHR
endif
# ENet feature defines — normally set by enet's CMake check_symbol_exists; all
# present on Android NDK API 31. Without HAS_SOCKLEN_T, unix.c redefines
# socklen_t as int and fails to compile. Names are enet-specific → harmless to
# other sources.
CFLAGS += -DHAS_SOCKLEN_T=1 -DHAS_FCNTL=1 -DHAS_POLL=1 -DHAS_GETADDRINFO=1 \
          -DHAS_GETNAMEINFO=1 -DHAS_GETHOSTBYNAME_R=1 -DHAS_GETHOSTBYADDR_R=1 \
          -DHAS_INET_PTON=1 -DHAS_INET_NTOP=1 -DHAS_MSGHDR_FLAGS=1

# Include paths
INCLUDE_PATHS = -I. -Icore/geometry -Icore/material -Icore/composition -Icore/presets -I$(RAYLIB_PATH)/src -I$(NATIVE_APP_GLUE_PATH) -I$(ENET_PATH)/include
ifeq ($(USE_VULKAN), 1)
    # third_party/vulkan/rlvk.h - Vulkan headers themselves come from the NDK sysroot
    # (auto-included via the NDK clang wrapper, same as <android/native_window.h>/<EGL/egl.h>).
    # third_party/vulkan/include - vendored shaderc.h (NDK's own copy lacks
    # set_vulkan_rules_relaxed; see COMPUTE_API.md / RLVK_HANDOFF.md §8.4 shaderc-on-device).
    INCLUDE_PATHS += -Ithird_party/vulkan -Ithird_party/vulkan/include
endif

# Linker flags
LDFLAGS = -Wl,-soname,lib$(PROJECT_LIBRARY_NAME).so -Wl,--exclude-libs,libatomic.a
ifeq ($(USE_VULKAN), 1)
    # Keep shaderc/glslang/SPIRV-Tools' huge internal symbol set out of our .so's dynamic
    # symbol table (bloat + collision risk) - only the shaderc_* C API needs to stay reachable,
    # and it does since rlvk_shaderc.inl calls it directly rather than through dlsym.
    LDFLAGS += -Wl,--exclude-libs,libshaderc_combined.a
endif
LDFLAGS += -Wl,--build-id -Wl,--no-undefined -Wl,-z,noexecstack -Wl,-z,relro -Wl,-z,now -Wl,--warn-shared-textrel -Wl,--fatal-warnings
LDFLAGS += -u ANativeActivity_onCreate
# raylib's Android FileIO wraps fopen to read from APK assets (__wrap_fopen in
# the raylib lib calls __real_fopen); the final link must supply --wrap=fopen.
LDFLAGS += -Wl,--wrap=fopen
LDFLAGS += -L. -L$(PROJECT_BUILD_PATH)/obj -L$(PROJECT_BUILD_PATH)/lib/$(ANDROID_ARCH_NAME)

# Libraries
LDLIBS = -lm -lc -lraylib -llog -landroid -lEGL -lGLESv2 -lGLESv3 -lOpenSLES -ldl
ifeq ($(USE_VULKAN), 1)
    # NDK stub lib; resolves against the device's real libvulkan.so at load time (API 24+
    # ships it on Vulkan-capable devices). EGL/GLESv2/v3 above stay linked too: rlvk only
    # replaces the rendering backend, not the platform's EGL-adjacent surface bootstrap that
    # raylib's own Android platform file still references at compile time either way.
    LDLIBS += -lvulkan
    # Statically-linked shaderc (compile_shaderc_android) + the C++ runtime it needs
    # (APP_STL=c++_shared) - libshaderc_combined.a is C++ (glslang/SPIRV-Tools/shaderc), our
    # own sources are C, so clang won't pull in libc++ automatically the way clang++ would.
    # Order matters: shaderc's undefined C++ symbols are resolved by c++_shared, which must
    # come after it on the link line.
    LDLIBS += -lshaderc_combined -lc++_shared
endif

# Object files
OBJS = $(patsubst %.c, $(PROJECT_BUILD_PATH)/obj/%.o, $(PROJECT_SOURCE_FILES))

# Source directories
PROJECT_SOURCE_DIRS = $(sort $(dir $(PROJECT_SOURCE_FILES)))

# =============================================================================
# BUILD TARGETS
# =============================================================================
all: create_temp_project_dirs \
     compile_raylib_android \
     copy_project_required_libs \
     copy_project_resources \
     generate_android_manifest \
     generate_apk_keystore \
     config_project_package \
     compile_project_code \
     create_project_apk_package \
     zipalign_project_apk_package \
     sign_project_apk_package

create_temp_project_dirs:
	python3 scripts/generate_registry.py
	mkdir -p $(PROJECT_BUILD_PATH)
	mkdir -p $(PROJECT_BUILD_PATH)/obj
	mkdir -p $(PROJECT_BUILD_PATH)/obj/src
	for dir in $(PROJECT_SOURCE_DIRS); do mkdir -p $(PROJECT_BUILD_PATH)/obj/$$dir; done
	mkdir -p $(PROJECT_BUILD_PATH)/src
	mkdir -p $(PROJECT_BUILD_PATH)/src/com
	mkdir -p $(PROJECT_BUILD_PATH)/src/com/$(APP_COMPANY_NAME)
	mkdir -p $(PROJECT_BUILD_PATH)/src/com/$(APP_COMPANY_NAME)/$(APP_PRODUCT_NAME)
	mkdir -p $(PROJECT_BUILD_PATH)/lib
	mkdir -p $(PROJECT_BUILD_PATH)/lib/$(ANDROID_ARCH_NAME)
	mkdir -p $(PROJECT_BUILD_PATH)/bin
	mkdir -p $(PROJECT_BUILD_PATH)/res
	mkdir -p $(PROJECT_BUILD_PATH)/res/drawable-ldpi
	mkdir -p $(PROJECT_BUILD_PATH)/res/drawable-mdpi
	mkdir -p $(PROJECT_BUILD_PATH)/res/drawable-hdpi
	mkdir -p $(PROJECT_BUILD_PATH)/res/values
	mkdir -p $(PROJECT_BUILD_PATH)/assets
	mkdir -p $(PROJECT_BUILD_PATH)/assets/textures
	mkdir -p $(PROJECT_BUILD_PATH)/assets/$(PROJECT_RESOURCES_PATH)

# Compile raylib for Android using CMake + NDK toolchain
# CUSTOMIZE_BUILD đã BỊ BỎ (CORE_ISSUES.md Item 41, giống CMakeLists.txt desktop):
# trên raylib 6.0 cờ này lật default một SUPPORT_* → EndDrawing không swap/không
# giới hạn FPS → app chạy (GL init OK, loop quay ~1000fps) nhưng KHÔNG bao giờ
# present frame nào lên surface = MÀN HÌNH ĐEN trên device. ĐỪNG bật lại.
#
# GLES3: PHẢI dùng -DOPENGL_VERSION="ES 3.0". Cờ -DGRAPHICS=... bị raylib CMake
# GHI ĐÈ vô điều kiện thành ES2 trên PLATFORM=Android (LibraryConfigurations
# .cmake); chỉ OPENGL_VERSION mới remap được sang GRAPHICS_API_OPENGL_ES3.
# Build ES2 trên Mali (ES 3.2) → con trỏ hàm instancing (glDrawElementsInstanced
# EXT/ANGLE) = NULL vì driver không quảng cáo extension (đã là core ES3) →
# SIGSEGV pc 0x0 trong DrawMeshInstanced ngay khi VFX instanced đầu tiên vẽ.
compile_raylib_android:
ifeq ($(USE_VULKAN), 1)
	@echo "=== Patching raylib for rlvk (idempotent) ===" && \
	python3 scripts/rlvk_patch_raylib.py $(CURDIR)/$(RAYLIB_PATH)
endif
	@LIBA="$(CURDIR)/$(PROJECT_BUILD_PATH)/lib/$(ANDROID_ARCH_NAME)/libraylib.a"; \
	STAMP="$(CURDIR)/$(PROJECT_BUILD_PATH)/lib/$(ANDROID_ARCH_NAME)/.raylib_backend"; \
	WANT="$(if $(filter 1,$(USE_VULKAN)),vulkan,gles)"; \
	HAVE="$$(cat "$$STAMP" 2>/dev/null || echo unknown)"; \
	RLVK_NEWER=""; \
	BACKEND_SWITCHED=""; \
	if [ -f "$$LIBA" ] && [ "$$HAVE" != "$$WANT" ]; then BACKEND_SWITCHED="1"; fi; \
	if [ "$(USE_VULKAN)" = "1" ] && [ -f "$$LIBA" ]; then \
		RLVK_NEWER=$$(find "$(CURDIR)/third_party/vulkan/rlvk.h" "$(CURDIR)/third_party/vulkan/rlvk" "$(CURDIR)/scripts/rlvk_patch_raylib.py" -newer "$$LIBA" 2>/dev/null); \
	fi; \
	if [ ! -f "$$LIBA" ] || [ -n "$$RLVK_NEWER" ] || [ -n "$$BACKEND_SWITCHED" ]; then \
		echo "=== Building raylib for Android ($(ANDROID_ARCH_NAME)) ===" && \
		[ -n "$$RLVK_NEWER" ] && echo "    (rlvk backend source changed since libraylib.a -> rebuilding: rlvk is compiled INTO raylib.a via the rlgl.h->rlvk.h patch)"; \
		if [ -n "$$BACKEND_SWITCHED" ]; then \
			echo "    (backend switched: libraylib.a was '$$HAVE', build wants '$$WANT' -> rebuilding. Without this the STALE archive links against the WRONG backend: a Vulkan-patched raylib.a linked without -lvulkan produces a wall of 'undefined symbol: vkCmdBindVertexBuffers' etc.)"; \
			echo "    (also dropping every .o/.d: they were compiled for the OTHER backend and are newer than their sources, so make would silently keep them and link a half-and-half binary)"; \
			find "$(CURDIR)/$(PROJECT_BUILD_PATH)/obj" \( -name '*.o' -o -name '*.d' \) -delete 2>/dev/null || true; \
		fi; \
		mkdir -p $(PROJECT_BUILD_PATH)/raylib_build && \
		cd $(PROJECT_BUILD_PATH)/raylib_build && \
		cmake $(CURDIR)/$(RAYLIB_PATH) \
			-DCMAKE_TOOLCHAIN_FILE=$(ANDROID_NDK)/build/cmake/android.toolchain.cmake \
			-DANDROID_ABI=$(ANDROID_ARCH_NAME) \
			-DANDROID_NATIVE_API_LEVEL=$(ANDROID_API_VERSION) \
			-DANDROID_PLATFORM=android-$(ANDROID_API_VERSION) \
			-DCMAKE_BUILD_TYPE=Release \
			-DBUILD_EXAMPLES=OFF \
			-DBUILD_GAMES=OFF \
			-DPLATFORM=Android \
			-DOPENGL_VERSION="ES 3.0" \
			$(if $(filter 1,$(USE_VULKAN)),-DCMAKE_C_FLAGS="-DGRAPHICS_API_VULKAN -DVK_USE_PLATFORM_ANDROID_KHR -I$(CURDIR)/third_party/vulkan -I$(CURDIR)/third_party/vulkan/include") && \
		cmake --build . --config Release -j8 && \
		cp -f raylib/libraylib.a "$$LIBA" && \
		echo "$$WANT" > "$$STAMP"; \
	else \
		echo "=== raylib for Android already built ($$HAVE), skipping ==="; \
	fi

# Build libshaderc as a static archive for on-device GLSL->SPIR-V compilation (rlvk).
# The NDK ships shaderc only as SOURCE (Android.mk for ndk-build) - there is no prebuilt
# libshaderc.so to dlopen on-device the way desktop/Linux distros ship one, so this project
# builds Google's own combined static archive (glslang + SPIRV-Tools + shaderc, same 9 libs
# the NDK's Android.mk itself `ar -M`-combines) via a throwaway ndk-build project, and links
# it straight into lib$(PROJECT_LIBRARY_NAME).so at compile_project_code time - see
# rlvk_shaderc.inl's __ANDROID__ branch (points its function pointers straight at the
# statically-linked symbols, no dlopen/dlsym). APP_STL=c++_shared means the archive depends on
# libc++_shared.so at runtime; that .so is pulled straight from the NDK toolchain's own sysroot
# (ndk-build's own libs/ output copy only happens for actual shared-lib targets, not a
# static-only build like this one - a real gap hit on first build, not a hypothetical) and
# packaged into the APK by create_project_apk_package below.
#
# The NDK's bundled shaderc source is old enough to lack shaderc_compile_options_set_vulkan_
# rules_relaxed entirely (confirmed on-device: virtually every custom shader failed with
# "'non-opaque uniforms outside a block' : not allowed when using GLSL for Vulkan" without it -
# RLVK_HANDOFF.md §7.18/§7.19). The underlying glslang compiler already implements the
# feature; only libshaderc's thin C-API wrapper was missing. scripts/rlvk_patch_shaderc.py
# adds it (4 files, ~15 lines) against a STAGED COPY of the source (never the NDK install
# itself - copied to shaderc_src/ first, then patched, then built) - same idempotent
# marker-guarded pattern as scripts/rlvk_patch_raylib.py.
#
# Cached like compile_raylib_android: skips the (~2-3 min) ndk-build if the archive already
# exists AND rlvk_patch_shaderc.py hasn't changed since - the mtime check (`-nt`, not just
# existence) exists because plain existence-only caching bit this project twice in one
# session (RLVK_HANDOFF.md §7.19/§7.20): editing the patch script after an archive was
# already cached silently kept shipping the stale, unpatched build with no error, no warning.
# Still needs a full `rm -f .../libshaderc_combined.a` if the NDK/toolchain version itself
# changes underneath it (not tracked by this check), same staleness caveat as raylib's §D2.
compile_shaderc_android:
ifeq ($(USE_VULKAN), 1)
	@if [ ! -f "$(PROJECT_BUILD_PATH)/lib/$(ANDROID_ARCH_NAME)/libshaderc_combined.a" ] || \
	    [ "$(CURDIR)/scripts/rlvk_patch_shaderc.py" -nt "$(PROJECT_BUILD_PATH)/lib/$(ANDROID_ARCH_NAME)/libshaderc_combined.a" ]; then \
		echo "=== Building shaderc for Android ($(ANDROID_ARCH_NAME)) ===" && \
		rm -rf $(PROJECT_BUILD_PATH)/shaderc_src && \
		cp -r $(ANDROID_NDK)/sources/third_party/shaderc $(PROJECT_BUILD_PATH)/shaderc_src && \
		python3 $(CURDIR)/scripts/rlvk_patch_shaderc.py $(CURDIR)/$(PROJECT_BUILD_PATH)/shaderc_src && \
		mkdir -p $(PROJECT_BUILD_PATH)/shaderc_build/jni && \
		printf 'NDK_MODULE_PATH := $$(call my-dir)\ninclude $(CURDIR)/$(PROJECT_BUILD_PATH)/shaderc_src/Android.mk\n' \
			> $(PROJECT_BUILD_PATH)/shaderc_build/jni/Android.mk && \
		printf 'APP_ABI := $(ANDROID_ARCH_NAME)\nAPP_PLATFORM := android-$(ANDROID_API_VERSION)\nAPP_STL := c++_shared\n' \
			> $(PROJECT_BUILD_PATH)/shaderc_build/jni/Application.mk && \
		$(ANDROID_NDK)/ndk-build libshaderc_combined \
			NDK_PROJECT_PATH=$(CURDIR)/$(PROJECT_BUILD_PATH)/shaderc_build \
			APP_BUILD_SCRIPT=$(CURDIR)/$(PROJECT_BUILD_PATH)/shaderc_build/jni/Android.mk \
			NDK_APPLICATION_MK=$(CURDIR)/$(PROJECT_BUILD_PATH)/shaderc_build/jni/Application.mk \
			-j8 && \
		mkdir -p $(PROJECT_BUILD_PATH)/lib/$(ANDROID_ARCH_NAME) && \
		cp -f $(PROJECT_BUILD_PATH)/shaderc_build/libs/c++_shared/$(ANDROID_ARCH_NAME)/libshaderc.a \
			$(PROJECT_BUILD_PATH)/lib/$(ANDROID_ARCH_NAME)/libshaderc_combined.a && \
		cp -f $(ANDROID_TOOLCHAIN)/sysroot/usr/lib/$(ANDROID_SYSROOT_TRIPLE)/libc++_shared.so \
			$(PROJECT_BUILD_PATH)/lib/$(ANDROID_ARCH_NAME)/libc++_shared.so; \
	else \
		echo "=== shaderc for Android already built, skipping ==="; \
	fi
endif

copy_project_required_libs:
	@echo "=== Copying libs ==="

# Copy project resources: icons, strings.xml, shader/texture assets
copy_project_resources: create_temp_project_dirs
	cp -f $(APP_ICON_LDPI) $(PROJECT_BUILD_PATH)/res/drawable-ldpi/icon.png
	cp -f $(APP_ICON_MDPI) $(PROJECT_BUILD_PATH)/res/drawable-mdpi/icon.png
	cp -f $(APP_ICON_HDPI) $(PROJECT_BUILD_PATH)/res/drawable-hdpi/icon.png
	@echo "<?xml version=\"1.0\" encoding=\"utf-8\"?>" > $(PROJECT_BUILD_PATH)/res/values/strings.xml
	@echo "<resources><string name=\"app_name\">$(APP_LABEL_NAME)</string></resources>" >> $(PROJECT_BUILD_PATH)/res/values/strings.xml
	@# Copy tuning.cfg (Item 9 data-driven tuning) — read-only on Android, no hot-reload there
	cp -f tuning.cfg $(PROJECT_BUILD_PATH)/assets/tuning.cfg 2>/dev/null || true
	@# Copy shader files và texture vào assets với đúng thư mục tương ứng
	mkdir -p $(PROJECT_BUILD_PATH)/assets/core/shaders/common
	cp -f core/shaders/*.vs $(PROJECT_BUILD_PATH)/assets/core/shaders/ 2>/dev/null || true
	cp -f core/shaders/*.fs $(PROJECT_BUILD_PATH)/assets/core/shaders/ 2>/dev/null || true
	cp -f core/shaders/common/*.glsl $(PROJECT_BUILD_PATH)/assets/core/shaders/common/ 2>/dev/null || true
	@# core/uv shared includes (flow_map.glsl moved here from core/shaders/common).
	@# These are #include'd by shield_shell.fs and aura_shell.fs, which ARE copied
	@# above — without this pair they resolve to nothing and the shader fails to
	@# compile, which raylib answers with the DEFAULT shader at a nonzero id.
	@# NOTE: core/trails/shaders/ is still not copied here at all (pre-existing),
	@# so trail_deform.fs already falls back to the classic pipeline on Android.
	mkdir -p $(PROJECT_BUILD_PATH)/assets/core/uv/shaders
	cp -f core/uv/shaders/*.glsl $(PROJECT_BUILD_PATH)/assets/core/uv/shaders/ 2>/dev/null || true
	mkdir -p $(PROJECT_BUILD_PATH)/assets/core/particles/shaders/gpu
	cp -f core/particles/shaders/gpu/*.comp $(PROJECT_BUILD_PATH)/assets/core/particles/shaders/gpu/ 2>/dev/null || true
	cp -f core/particles/shaders/gpu/*.vs $(PROJECT_BUILD_PATH)/assets/core/particles/shaders/gpu/ 2>/dev/null || true
	cp -f core/particles/shaders/gpu/*.fs $(PROJECT_BUILD_PATH)/assets/core/particles/shaders/gpu/ 2>/dev/null || true
	
	@# Tự động quét và sao chép cấu trúc thư mục của skills/ cùng các asset liên quan (.fs, .vs, .png)
	mkdir -p $(PROJECT_BUILD_PATH)/assets/skills
	cd skills && find . -type d -exec mkdir -p ../$(PROJECT_BUILD_PATH)/assets/skills/{} \;
	cd skills && find . -type f \( -name "*.fs" -o -name "*.png" -o -name "*.vs" \) -exec cp -f {} ../$(PROJECT_BUILD_PATH)/assets/skills/{} \;

	@# Copy toàn bộ thư mục assets vào assets/assets để AssetManager đọc được chuỗi "assets/..."
	mkdir -p $(PROJECT_BUILD_PATH)/assets/assets
	cp -rf assets/* $(PROJECT_BUILD_PATH)/assets/assets/ 2>/dev/null || true

	@# environment/shaders (shadow_depth.vs/.fs) — BỎ SÓT cho tới 2026-07-22. Không có luật copy
	@# nào cho environment/, nên trên máy ResourceManager_LoadShader thất bại và raylib im lặng
	@# rơi về SHADER MẶC ĐỊNH cho pass capture bóng: shadow map R32F khi đó chứa MÀU của caster
	@# chứ không phải gl_FragCoord.z, nên bóng vẫn "có" nhưng sai bản chất.
	@# Dấu hiệu trong logcat: "SHADER: Không đọc được file: environment/shaders/shadow_depth.vs"
	@# rồi ID kế tiếp compile với 3 uniforms (shader mặc định) thay vì 1 (shadow_depth thật).
	mkdir -p $(PROJECT_BUILD_PATH)/assets/environment/shaders
	cp -f environment/shaders/*.vs $(PROJECT_BUILD_PATH)/assets/environment/shaders/ 2>/dev/null || true
	cp -f environment/shaders/*.fs $(PROJECT_BUILD_PATH)/assets/environment/shaders/ 2>/dev/null || true

	@# Tự động sao chép các tệp tài nguyên của maps/ (như shader bamboo_alpha.fs) vào assets của APK
	mkdir -p $(PROJECT_BUILD_PATH)/assets/maps
	cd maps && find . -type d -exec mkdir -p ../$(PROJECT_BUILD_PATH)/assets/maps/{} \;
	cd maps && find . -type f \( -name "*.fs" -o -name "*.png" -o -name "*.vs" \) -exec cp -f {} ../$(PROJECT_BUILD_PATH)/assets/maps/{} \;
	
	@# Chạy script Python để convert Shader từ GLSL 330 sang GLES 100/300 es
	@# rlvk (Vulkan backend) needs the ORIGINAL desktop-dialect GLSL 330 (in/out, #version 330)
	@# unchanged - shaderc targets vulkan1.1/SPIR-V1.3 and rejects GLES-100 syntax outright
	@# ('attribute'/'varying' are reserved words in that dialect, and ES #version directives
	@# need 310+ for SPIR-V) - confirmed via on-device RLVK: GLSL compile failed logs after
	@# shaderc-on-device (§7.18) started actually attempting real compiles. Skip the conversion
	@# entirely under USE_VULKAN=1; only the GLES/GL backend needs it.
ifneq ($(USE_VULKAN), 1)
	python3 $(CURDIR)/scripts/convert_shaders_to_gles.py $(PROJECT_BUILD_PATH)/assets
endif

generate_android_manifest: create_temp_project_dirs
	@echo "<?xml version=\"1.0\" encoding=\"utf-8\"?>" > $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\"" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "        package=\"com.$(APP_COMPANY_NAME).$(APP_PRODUCT_NAME)\" " >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "        android:versionCode=\"$(APP_VERSION_CODE)\" android:versionName=\"$(APP_VERSION_NAME)\" >" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "    <uses-sdk android:minSdkVersion=\"24\" android:targetSdkVersion=\"$(ANDROID_API_VERSION)\" />" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "    <uses-feature android:glEsVersion=\"0x00020000\" android:required=\"true\" />" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "    <application android:allowBackup=\"false\" android:hasCode=\"false\" android:extractNativeLibs=\"true\" android:label=\"@string/app_name\" android:icon=\"@drawable/icon\" >" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "        <activity android:name=\"android.app.NativeActivity\"" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "            android:exported=\"true\"" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "            android:theme=\"@android:style/Theme.NoTitleBar.Fullscreen\"" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "             android:configChanges=\"orientation|keyboardHidden|screenSize\"" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "            android:screenOrientation=\"$(APP_SCREEN_ORIENTATION)\" android:launchMode=\"singleTask\"" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "            android:clearTaskOnLaunch=\"true\">" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "            <meta-data android:name=\"android.app.lib_name\" android:value=\"$(PROJECT_LIBRARY_NAME)\" />" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "            <intent-filter>" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "                <action android:name=\"android.intent.action.MAIN\" />" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "                <category android:name=\"android.intent.category.LAUNCHER\" />" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "            </intent-filter>" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "        </activity>" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "    </application>" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml
	@echo "</manifest>" >> $(PROJECT_BUILD_PATH)/AndroidManifest.xml

generate_apk_keystore:
	@[ -f "$(PROJECT_BUILD_PATH)/$(PROJECT_NAME).keystore" ] || \
		$(JAVA_HOME)/bin/keytool -genkeypair -validity 10000 \
		-dname "CN=$(APP_COMPANY_NAME),O=Android,C=VN" \
		-keystore $(PROJECT_BUILD_PATH)/$(PROJECT_NAME).keystore \
		-storepass $(APP_KEYSTORE_PASS) -keypass $(APP_KEYSTORE_PASS) \
		-alias $(PROJECT_NAME)Key -keyalg RSA -storetype JKS

config_project_package: copy_project_resources generate_android_manifest
	$(ANDROID_BUILD_TOOLS)/aapt package -f -m \
		-S $(PROJECT_BUILD_PATH)/res \
		-M $(PROJECT_BUILD_PATH)/AndroidManifest.xml \
		-I $(ANDROID_HOME)/platforms/android-$(ANDROID_API_VERSION)/android.jar

compile_project_code: config_project_package compile_raylib_android compile_shaderc_android $(OBJS)
	$(CC) -o $(PROJECT_BUILD_PATH)/lib/$(ANDROID_ARCH_NAME)/lib$(PROJECT_LIBRARY_NAME).so \
		$(OBJS) -shared $(INCLUDE_PATHS) $(LDFLAGS) $(LDLIBS)

$(PROJECT_BUILD_PATH)/obj/%.o:%.c
	# $< (the .c only), NOT $^: once the -include'd .d files exist, $^ pulls in every
	# header prerequisite too, and clang rejects multiple inputs with a single -o
	# ("cannot specify -o when generating multiple output files").
	$(CC) -c $< -o $@ $(INCLUDE_PATHS) $(CFLAGS) -MMD -MP

# Per-file header dependencies (generated by -MMD -MP above, e.g.
# obj/core/skill_manager.o.d listing every .h it transitively includes).
# Without this, incremental `make` only notices a changed .c file's OWN mtime -
# editing a .h (skill_manager.h, entities.h, ...) without touching any .c file
# directly leaves every .o that includes it silently stale, so the header edit
# has no effect until a full clean rebuild. `-include` is silent on missing
# files (first build, before any .d exists) instead of erroring.
-include $(OBJS:.o=.d)

create_project_apk_package: compile_project_code
	$(ANDROID_BUILD_TOOLS)/aapt package -f \
		-M $(PROJECT_BUILD_PATH)/AndroidManifest.xml \
		-S $(PROJECT_BUILD_PATH)/res \
		-A $(PROJECT_BUILD_PATH)/assets \
		-I $(ANDROID_HOME)/platforms/android-$(ANDROID_API_VERSION)/android.jar \
		-F $(PROJECT_BUILD_PATH)/$(PROJECT_NAME).unsigned.apk $(PROJECT_BUILD_PATH)/bin
	cd $(PROJECT_BUILD_PATH) && $(ANDROID_BUILD_TOOLS)/aapt add \
		$(PROJECT_NAME).unsigned.apk lib/$(ANDROID_ARCH_NAME)/lib$(PROJECT_LIBRARY_NAME).so
ifeq ($(USE_VULKAN), 1)
	@# libc++_shared.so: runtime dependency of the statically-linked shaderc archive
	@# (compile_shaderc_android, APP_STL=c++_shared) - must ship in the APK or dlopen of our
	@# own lib$(PROJECT_LIBRARY_NAME).so fails to resolve its C++ symbols on-device.
	cd $(PROJECT_BUILD_PATH) && $(ANDROID_BUILD_TOOLS)/aapt add \
		$(PROJECT_NAME).unsigned.apk lib/$(ANDROID_ARCH_NAME)/libc++_shared.so
endif

zipalign_project_apk_package: create_project_apk_package
	$(ANDROID_BUILD_TOOLS)/zipalign -p -f 4 \
		$(PROJECT_BUILD_PATH)/$(PROJECT_NAME).unsigned.apk $(PROJECT_BUILD_PATH)/$(PROJECT_NAME).aligned.apk

sign_project_apk_package: zipalign_project_apk_package generate_apk_keystore
	$(ANDROID_BUILD_TOOLS)/apksigner sign --ks $(PROJECT_BUILD_PATH)/$(PROJECT_NAME).keystore \
		--ks-pass pass:$(APP_KEYSTORE_PASS) --key-pass pass:$(APP_KEYSTORE_PASS) \
		--ks-key-alias $(PROJECT_NAME)Key \
		--out $(PROJECT_NAME).apk \
		$(PROJECT_BUILD_PATH)/$(PROJECT_NAME).aligned.apk
	@echo "=== APK đã sẵn sàng: $(PROJECT_NAME).apk ==="

install:
	$(ANDROID_PLATFORM_TOOLS)/adb install $(PROJECT_NAME).apk

logcat:
	$(ANDROID_PLATFORM_TOOLS)/adb logcat -c
	$(ANDROID_PLATFORM_TOOLS)/adb logcat raylib:V *:S

deploy:
	$(ANDROID_PLATFORM_TOOLS)/adb install $(PROJECT_NAME).apk
	$(ANDROID_PLATFORM_TOOLS)/adb logcat -c
	$(ANDROID_PLATFORM_TOOLS)/adb logcat raylib:V *:S

clean:
	rm -rf $(PROJECT_BUILD_PATH)
	rm -f $(PROJECT_NAME).apk
	@echo Cleaning done
