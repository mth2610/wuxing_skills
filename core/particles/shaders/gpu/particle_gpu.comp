#version 310 es
// Compute shader — cập nhật vật lý particle trên GPU.
// Source giữ ở GLES 3.1 syntax (#version 310 es).
// Desktop GL 4.3: CompileComputeShader() tự nâng lên #version 430 core lúc runtime.

precision highp float;
precision highp int;
precision highp sampler2D;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Phải khớp byte-for-byte với GpuParticleData trong gpu_particle_system.c
struct GpuParticleData {
    vec4 pos_radius;     // xyz = position, w = radius
    vec4 vel_drag;       // xyz = velocity, w = drag coefficient
    vec4 color_start;    // rgba normalized (0..1)
    vec4 color_end;      // rgba normalized (0..1)
    vec4 life_data;      // x = life_remaining, y = life_max, z = phase, w = active (0/1)
    vec4 ff_data;        // x = force field slot (-1 = none), yzw = reserved
    vec4 route_data;     // x=emitter id, y=render mode, z=travel slot, w=waypoint
    vec4 impact_data;    // x=impact age, y=impact active
    vec4 formation_data; // xyz = per-particle offset from formation origin
};

layout(std430, binding = 0) buffer ParticleBuffer {
    GpuParticleData particles[];
};

// ---------------------------------------------------------------------------
// Force field — phải khớp byte-for-byte với ForceLayerGPU/ForceFieldGPU
// trong core/force_field.h (không sửa header đó, chỉ mirror layout ở đây,
// giống cách GpuParticleData đã được mirror thủ công giữa .comp/.c/.vs).
// ---------------------------------------------------------------------------
struct ForceLayerGPU {
    vec4 origin;    // xyz dùng, w đệm
    vec4 direction; // xyz dùng, w đệm
    vec4 params0;   // x: strength, y: radius, z: falloff, w: (float)type
    vec4 params1;   // x: noiseScale, y: noiseSpeed, zw: dự trữ
};

#define FF_MAX_LAYERS 8

struct ForceFieldGPU {
    ForceLayerGPU layers[FF_MAX_LAYERS];
    ivec4 meta; // x = layerCount
};

layout(std430, binding = 1) readonly buffer ForceFieldBuffer {
    ForceFieldGPU uFields[];
};

#define TRAVEL_MAX_WAYPOINTS 16
#define MAX_GPU_TRAVEL_PATHS 32
struct ParticleTravelPathGPU {
    vec4 points[TRAVEL_MAX_WAYPOINTS];
    vec4 params; // x=count, y=speed, z=steering, w=max acceleration
    vec4 radii;  // x=waypoint radius, y=target radius
    vec4 arrival; // x=arrival force slot, y=offset, z=kick
    vec4 formation_origin;
};

layout(std430, binding = 2) readonly buffer ParticleTravelPathBuffer {
    ParticleTravelPathGPU uTravelPaths[];
};

// Phải khớp thứ tự enum ForceType trong core/force_field.h
#define FT_GRAVITY_DIR   0
#define FT_GRAVITY_POINT 1
#define FT_VORTEX        2
#define FT_WIND          3
#define FT_NOISE_PERLIN  4
#define FT_NOISE_CURL    5
#define FT_DRAG          6
#define FT_VISCOSITY     7
#define FT_RADIAL_AXIS   8
#define FT_VORTEX_AXIS   9
#define FT_VECTOR_TEXTURE 10

uniform float u_dt;
uniform float u_time;

// Vector field textures — RG = hướng flow XZ remap [-1,1] -> [0,1].
// Slot index chọn qua ForceLayer.noiseScale (xem core/force_field.h).
uniform sampler2D uVectorField0;
uniform sampler2D uVectorField1;

// TỐI ƯU HÓA: Hash không dùng hàm lượng giác (sin), nhẹ hơn rất nhiều cho GPU ALU
vec3 hash3(vec3 p) {
    p = fract(p * vec3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yxz + 33.33);
    return fract((p.xxy + p.yxx) * p.zyx) * 2.0 - 1.0;
}

float noiseScalar(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);
    float n000 = dot(hash3(i + vec3(0,0,0)), f - vec3(0,0,0));
    float n100 = dot(hash3(i + vec3(1,0,0)), f - vec3(1,0,0));
    float n010 = dot(hash3(i + vec3(0,1,0)), f - vec3(0,1,0));
    float n110 = dot(hash3(i + vec3(1,1,0)), f - vec3(1,1,0));
    float n001 = dot(hash3(i + vec3(0,0,1)), f - vec3(0,0,1));
    float n101 = dot(hash3(i + vec3(1,0,1)), f - vec3(1,0,1));
    float n011 = dot(hash3(i + vec3(0,1,1)), f - vec3(0,1,1));
    float n111 = dot(hash3(i + vec3(1,1,1)), f - vec3(1,1,1));
    float nx00 = mix(n000, n100, u.x);
    float nx10 = mix(n010, n110, u.x);
    float nx01 = mix(n001, n101, u.x);
    float nx11 = mix(n011, n111, u.x);
    float nxy0 = mix(nx00, nx10, u.y);
    float nxy1 = mix(nx01, nx11, u.y);
    return mix(nxy0, nxy1, u.z); // ~[-1, 1]
}

// Curl xấp xỉ bằng finite-difference trên noiseScalar
vec3 curlNoise3(vec3 p) {
    const float e = 0.1;
    float dx  = noiseScalar(p + vec3(e,0,0)) - noiseScalar(p - vec3(e,0,0));
    float dy  = noiseScalar(p + vec3(0,e,0)) - noiseScalar(p - vec3(0,e,0));
    float dz  = noiseScalar(p + vec3(0,0,e)) - noiseScalar(p - vec3(0,0,e));
    float dx2 = noiseScalar(p + vec3(e,0,0) + vec3(31.4,0,0)) - noiseScalar(p - vec3(e,0,0) + vec3(31.4,0,0));
    float dy2 = noiseScalar(p + vec3(0,e,0) + vec3(0,47.7,0)) - noiseScalar(p - vec3(0,e,0) + vec3(0,47.7,0));
    float dz2 = noiseScalar(p + vec3(0,0,e) + vec3(0,0,58.9)) - noiseScalar(p - vec3(0,0,e) + vec3(0,0,58.9));
    return vec3(dy2 - dz, dz2 - dx, dx2 - dy) / (2.0 * e);
}

// Phải khớp CalcAttenuation() trong core/force_field.c
float calcAttenuation(vec3 origin, float radius, float falloff, vec3 pos) {
    if (radius <= 0.0) return 1.0;
    vec3 diff = pos - origin;
    float distSq = dot(diff, diff);
    if (distSq >= radius * radius) return 0.0;
    float t = sqrt(distSq) / radius;
    if (falloff <= 0.0) return 1.0;
    if (falloff <= 1.0) return 1.0 - t;
    return (1.0 - t) * (1.0 - t);
}

// TỐI ƯU HÓA: Truyền `out float outTotalVisc` để gộp vòng lặp SSBO
vec3 evalForceField(int idx, vec3 pos, vec3 vel, float time, out float outTotalVisc) {
    vec3 totalAcc = vec3(0.0);
    outTotalVisc = 0.0;
    
    if (idx < 0) return totalAcc;

    // TỐI ƯU HÓA: Không copy toàn bộ ForceFieldGPU vào local (ngăn tràn thanh ghi)
    int n = uFields[idx].meta.x;
    if (n > FF_MAX_LAYERS) n = FF_MAX_LAYERS;

    for (int i = 0; i < n; i++) {
        // Chỉ copy layer hiện tại
        ForceLayerGPU L = uFields[idx].layers[i];
        
        int   type     = int(L.params0.w + 0.5);
        vec3  o        = L.origin.xyz;
        vec3  dir      = L.direction.xyz;
        float strength = L.params0.x;
        float radius   = L.params0.y;
        float falloff  = L.params0.z;
        float nScale   = L.params1.x;
        float nSpeed   = L.params1.y;

        // Gộp tính toán Viscosity vào cùng 1 pass
        if (type == FT_VISCOSITY) {
            outTotalVisc += strength;
            continue; 
        }

        float atten = 1.0;
        vec3  acc   = vec3(0.0);

        if (type != FT_RADIAL_AXIS && type != FT_VORTEX_AXIS) {
            atten = calcAttenuation(o, radius, falloff, pos);
            if (atten <= 0.0) continue;
        }

        if (type == FT_GRAVITY_DIR) {
            acc = dir * strength;

        } else if (type == FT_GRAVITY_POINT) {
            vec3 toOrigin = o - pos;
            float distSq = dot(toOrigin, toOrigin);
            if (distSq >= 1e-4) {
                float dist = sqrt(distSq);
                acc = (toOrigin / dist) * (strength / (dist + 1.0));
            }

        } else if (type == FT_VORTEX) {
            vec3 axis = normalize(dir);
            vec3 toPos = pos - o;
            vec3 radial = toPos - axis * dot(toPos, axis);
            float dist = length(radial);
            if (dist >= 1e-3) {
                vec3 tangent = normalize(cross(axis, radial));
                acc = tangent * (strength / (dist + 1.0));
            }

        } else if (type == FT_WIND) {
            float t = time * nSpeed;
            float nx = noiseScalar(vec3(pos.x * nScale + t, pos.y * nScale, pos.z * nScale));
            float nz = noiseScalar(vec3(pos.x * nScale + 53.9, pos.y * nScale, pos.z * nScale + t));
            acc = dir * strength + vec3(nx, 0.0, nz) * strength * 0.35;

        } else if (type == FT_NOISE_PERLIN) {
            float t = time * nSpeed;
            float nx = noiseScalar(vec3(pos.x * nScale + t,    pos.y * nScale + 17.7, pos.z * nScale + 17.7));
            float ny = noiseScalar(vec3(pos.x * nScale + 37.3, pos.y * nScale + t,    pos.z * nScale + 37.3));
            float nz = noiseScalar(vec3(pos.x * nScale + 73.1, pos.y * nScale + 73.1, pos.z * nScale + t));
            acc = vec3(nx, ny, nz) * strength;

        } else if (type == FT_NOISE_CURL) {
            float t = time * nSpeed;
            vec3 p = vec3(pos.x * nScale + t, pos.y * nScale, pos.z * nScale + t);
            acc = curlNoise3(p) * strength;

        } else if (type == FT_DRAG) {
            acc = -strength * vel;

        } else if (type == FT_RADIAL_AXIS || type == FT_VORTEX_AXIS) {
            if (dot(dir, dir) >= 1e-6) {
                vec3 toPoint = pos - o;
                float alongAxis = dot(toPoint, dir);
                vec3 closestOnAxis = o + dir * alongAxis;
                vec3 radialVec = pos - closestOnAxis;
                float perpDistSq = dot(radialVec, radialVec);
                bool outOfRadius = (radius > 0.0 && perpDistSq >= radius * radius);
                if (!outOfRadius && perpDistSq >= 1e-6) {
                    float perpDist = sqrt(perpDistSq);
                    if (radius <= 0.0) {
                        atten = 1.0;
                    } else {
                        float tt = perpDist / radius;
                        if (falloff <= 0.0) atten = 1.0;
                        else if (falloff <= 1.0) atten = 1.0 - tt;
                        else atten = (1.0 - tt) * (1.0 - tt);
                    }
                    if (type == FT_RADIAL_AXIS) {
                        acc = (radialVec * (-1.0 / perpDist)) * strength;
                    } else {
                        vec3 tangent = normalize(cross(dir, radialVec));
                        acc = tangent * (strength / (perpDist + 1.0));
                    }
                }
            }

        } else if (type == FT_VECTOR_TEXTURE) {
            vec2 halfExtent = dir.xz;
            if (halfExtent.x > 1e-4 && halfExtent.y > 1e-4) {
                vec2 uv = (pos.xz - o.xz) / (2.0 * halfExtent) + 0.5;
                if (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0) {
                    int slot = int(nScale + 0.5);
                    // SỬA LỖI: Compute Shader yêu cầu explicit LOD (textureLod)
                    vec4 texel = (slot == 1) ? textureLod(uVectorField1, uv, 0.0)
                                              : textureLod(uVectorField0, uv, 0.0);
                    vec2 flow = texel.rg * 2.0 - 1.0;
                    acc = vec3(flow.x, 0.0, flow.y) * strength;
                }
            }
        }

        totalAcc += acc * atten;
    }
    return totalAcc;
}

float segmentDistanceSq(vec3 a, vec3 b, vec3 point) {
    vec3 ab = b - a;
    float denom = dot(ab, ab);
    float t = denom > 1e-8 ? clamp(dot(point - a, ab) / denom, 0.0, 1.0) : 0.0;
    vec3 delta = a + ab * t - point;
    return dot(delta, delta);
}

// Mirrors ParticleTravel_Step. Force and drag have already modified `vel`;
// finite steering guides that result instead of erasing field deflection.
bool evalTravelPath(int pathIndex, inout vec3 pos, inout vec3 vel,
                    inout float waypointValue, float dt, vec3 formationOffset) {
    if (pathIndex < 0 || pathIndex >= MAX_GPU_TRAVEL_PATHS) return false;
    int count = clamp(int(uTravelPaths[pathIndex].params.x + 0.5),
                      0, TRAVEL_MAX_WAYPOINTS);
    if (count <= 0) return false;
    int finalIndex = count - 1;
    int waypoint = clamp(int(waypointValue + 0.5), 0, finalIndex);
    vec3 baseA = waypoint > 0 ? uTravelPaths[pathIndex].points[waypoint - 1].xyz
                              : uTravelPaths[pathIndex].formation_origin.xyz;
    vec3 baseB = uTravelPaths[pathIndex].points[min(waypoint, finalIndex)].xyz;
    vec3 fromT = normalize(uTravelPaths[pathIndex].points[0].xyz -
                           uTravelPaths[pathIndex].formation_origin.xyz);
    vec3 toT = normalize(baseB - baseA);
    vec3 rotAxis = cross(fromT, toT);
    float rotSin = length(rotAxis);
    float rotCos = clamp(dot(fromT, toT), -1.0, 1.0);
    vec3 transportedOffset = formationOffset;
    if (rotSin > 1e-5) {
        rotAxis /= rotSin;
        transportedOffset = formationOffset * rotCos +
            cross(rotAxis, formationOffset) * rotSin +
            rotAxis * dot(rotAxis, formationOffset) * (1.0 - rotCos);
    } else if (rotCos < 0.0) transportedOffset = -formationOffset;
    float waypointRadius = uTravelPaths[pathIndex].radii.x > 0.0
                               ? uTravelPaths[pathIndex].radii.x : 0.10;
    float targetRadius = uTravelPaths[pathIndex].radii.y > 0.0
                             ? uTravelPaths[pathIndex].radii.y : waypointRadius;

    for (int i = 0; i < TRAVEL_MAX_WAYPOINTS - 1; ++i) {
        if (waypoint >= finalIndex) break;
        vec3 occupiedGoal = uTravelPaths[pathIndex].points[waypoint].xyz + transportedOffset;
        vec3 occupiedDelta = pos - occupiedGoal;
        if (dot(occupiedDelta, occupiedDelta) > waypointRadius * waypointRadius)
            break;
        waypoint++;
    }

    vec3 goal = uTravelPaths[pathIndex].points[waypoint].xyz + transportedOffset;
    vec3 toGoal = goal - pos;
    float distanceToGoal = length(toGoal);
    float speed = uTravelPaths[pathIndex].params.y;
    if (speed <= 0.0) {
        speed = length(vel);
        if (speed <= 1e-4) speed = 1.0;
    }
    vec3 desired = distanceToGoal > 1e-5 ? toGoal * (speed / distanceToGoal)
                                          : vec3(0.0);
    float steering = uTravelPaths[pathIndex].params.z > 0.0
                         ? uTravelPaths[pathIndex].params.z : 8.0;
    vec3 velocityDelta = (desired - vel) * (1.0 - exp(-steering * dt));
    float maxAcceleration = uTravelPaths[pathIndex].params.w;
    float changeLength = length(velocityDelta);
    if (maxAcceleration > 0.0 && changeLength > maxAcceleration * dt &&
        changeLength > 1e-6)
        velocityDelta *= (maxAcceleration * dt) / changeLength;
    vel += velocityDelta;

    vec3 next = pos + vel * dt;
    float hitRadius = waypoint == finalIndex ? targetRadius : waypointRadius;
    if (segmentDistanceSq(pos, next, goal) <= hitRadius * hitRadius) {
        if (waypoint == finalIndex) {
            pos = goal;
            waypointValue = float(waypoint);
            return true;
        }
        waypoint++;
    }
    pos = next;
    waypointValue = float(waypoint);
    return false;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(particles.length())) return;

    GpuParticleData p = particles[idx];

    // Skip inactive
    if (p.life_data.w < 0.5) return;

    // Decrement lifetime
    p.life_data.x -= u_dt;
    if (p.life_data.x <= 0.0) {
        p.life_data.w = 0.0; // deactivate
        particles[idx] = p;
        return;
    }

    int pathIndex = int(p.route_data.z);
    bool impactActive = p.impact_data.y > 0.5;
    int forceIndex = int(p.ff_data.x);
    if (impactActive && pathIndex >= 0 && pathIndex < MAX_GPU_TRAVEL_PATHS &&
        (uTravelPaths[pathIndex].radii.z <= 0.0 ||
         p.impact_data.x <= uTravelPaths[pathIndex].radii.z))
        forceIndex = int(uTravelPaths[pathIndex].arrival.x + 0.5);
    float totalVisc = 0.0;
    vec3 ffAccel = evalForceField(forceIndex, p.pos_radius.xyz, p.vel_drag.xyz, u_time, totalVisc);
    
    p.vel_drag.xyz += ffAccel * u_dt;

    // Viscosity damping — tính toán từ kết quả gộp
    if (totalVisc > 0.0) {
        p.vel_drag.xyz *= exp(-totalVisc * u_dt);
    }

    // Drag — giảm vận tốc mỗi frame
    float drag_factor = 1.0 - p.vel_drag.w * u_dt;
    drag_factor = max(drag_factor, 0.0);
    p.vel_drag.xyz *= drag_factor;

    // Guided travel owns integration when a path slot is present.
    bool reachedTarget = false;
    if (!impactActive)
        reachedTarget = evalTravelPath(pathIndex, p.pos_radius.xyz,
                                       p.vel_drag.xyz, p.route_data.w, u_dt,
                                       p.formation_data.xyz);
    else {
        p.pos_radius.xyz += p.vel_drag.xyz * u_dt;
        p.impact_data.x += u_dt;
    }
    if (reachedTarget && uTravelPaths[pathIndex].arrival.x >= -0.5) {
        vec3 outward = normalize(p.vel_drag.xyz);
        if (dot(outward, outward) < 1e-6) outward = vec3(1.0, 0.0, 0.0);
        if (uTravelPaths[pathIndex].arrival.w > 0.0)
            p.vel_drag.xyz *= uTravelPaths[pathIndex].arrival.w;
        p.pos_radius.xyz += outward * uTravelPaths[pathIndex].arrival.y;
        p.vel_drag.xyz += outward * uTravelPaths[pathIndex].arrival.z;
        p.impact_data.x = 0.0;
        p.impact_data.y = 1.0;
    } else if (reachedTarget) {
        p.life_data.w = 0.0;
        particles[idx] = p;
        return;
    }
    if (p.route_data.z < 0.0)
        p.pos_radius.xyz += p.vel_drag.xyz * u_dt;

    // Ground Collision Y-bounce
    float elasticity = p.ff_data.z; // ff_pad1
    if (elasticity >= 0.0) {
        float floorY = p.ff_data.w; // ff_pad2
        if (p.pos_radius.y <= floorY) {
            p.vel_drag.y = -p.vel_drag.y * elasticity;
            p.vel_drag.xz *= 0.8;
            p.pos_radius.y = floorY + 0.005;
        }
    }

    particles[idx] = p;
}
