#version 310 es
// Compute shader — cập nhật vật lý particle trên GPU.
// Source giữ ở GLES 3.1 syntax (#version 310 es).
// Desktop GL 4.3: CompileComputeShader() tự nâng lên #version 430 core lúc runtime.

precision highp float;
precision highp int;
precision highp sampler2D;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Phải khớp byte-for-byte với GpuParticleData trong particle_gpu_backend.c
struct GpuParticleData {
    vec4 pos_radius;     // xyz = position, w = radius
    vec4 vel_drag;       // xyz = velocity, w = drag coefficient
    vec4 color_start;    // rgba normalized (0..1)
    vec4 color_end;      // rgba normalized (0..1)
    vec4 life_data;      // x = life_remaining, y = life_max, z = phase, w = active (0/1)
    vec4 ff_data;        // x = force field slot (-1 = none), yzw = reserved
    vec4 route_data;     // x=emitter id, y=render mode, z=travel slot, w=waypoint
    vec4 impact_data;    // x=impact age, y=impact active, z=wind_influence, w=blendMode
    vec4 formation_data; // xyz = per-particle offset from formation origin
};

layout(std430, binding = 0) buffer ParticleBuffer {
    GpuParticleData particles[];
};

// ---------------------------------------------------------------------------
// Force field — phải khớp byte-for-byte với ForceLayerGPU/ForceFieldGPU
// trong core/force_field.h.
// ---------------------------------------------------------------------------
struct ForceLayerGPU {
    vec4 origin;    // xyz dùng, w đệm
    vec4 direction; // xyz dùng, w đệm
    vec4 params0;   // x: strength, y: radius, z: falloff, w: (float)type
    vec4 params1;   // x: noiseScale, y: noiseSpeed, zw: dự trữ
};

#define FF_MAX_LAYERS 8

struct ForceFieldGPU {
    ForceLayerGPU layers[FF_MAX_LAYERS];
    ivec4 meta; // x = layerCount
};

layout(std430, binding = 1) readonly buffer ForceFieldBuffer {
    ForceFieldGPU uFields[];
};

#define TRAVEL_MAX_WAYPOINTS 16
#define MAX_GPU_TRAVEL_PATHS 32
struct ParticleTravelPathGPU {
    vec4 points[TRAVEL_MAX_WAYPOINTS];
    vec4 params;  // x=count, y=speed, z=steering, w=max acceleration
    vec4 radii;   // x=waypoint radius, y=target radius, z=arrivalForceDuration
    vec4 arrival; // x=arrival force slot, y=offset, z=kick, w=velScale
    vec4 formation_origin;
};

layout(std430, binding = 2) readonly buffer ParticleTravelPathBuffer {
    ParticleTravelPathGPU uTravelPaths[];
};

#include "core/motion/shaders/motion_wind_types.glsl"

// Phải khớp thứ tự enum ForceType trong core/force_field.h
#define FT_GRAVITY_DIR    0
#define FT_GRAVITY_POINT  1
#define FT_VORTEX         2
#define FT_WIND           3
#define FT_NOISE_PERLIN   4
#define FT_NOISE_CURL     5
#define FT_DRAG           6
#define FT_VISCOSITY      7
#define FT_RADIAL_AXIS    8
#define FT_VORTEX_AXIS    9
#define FT_VECTOR_TEXTURE 10
#define FT_RECEIVER_PLANE 11

uniform float u_dt;
uniform float u_time;

// Vector field textures — RG = hướng flow XZ remap [-1,1] -> [0,1].
uniform sampler2D uVectorField0;
uniform sampler2D uVectorField1;

#include "core/motion/shaders/motion_wind_noise.glsl"

// Phải khớp CalcAttenuation() trong core/force_field.c
float calcAttenuation(vec3 origin, float radius, float falloff, vec3 pos) {
    if (radius <= 0.0) return 1.0;
    vec3 diff = pos - origin;
    float distSq = dot(diff, diff);
    if (distSq >= radius * radius) return 0.0;
    float t = sqrt(distSq) / radius;
    if (falloff <= 0.0) return 1.0;
    if (falloff <= 1.0) return 1.0 - t;
    float omt = 1.0 - t;
    return omt * omt;
}

bool motionPhysicalNoise = false;
float fieldNoiseScalar(vec3 p);
vec3 fieldCurlNoise(vec3 p);

vec3 evalForceField(int idx, vec3 pos, vec3 vel, float time, out float outTotalVisc) {
    vec3 totalAcc = vec3(0.0);
    outTotalVisc = 0.0;

    if (idx < 0 || idx >= int(uFields.length())) return totalAcc;

    int n = clamp(uFields[idx].meta.x, 0, FF_MAX_LAYERS);

    for (int i = 0; i < n; i++) {
        ForceLayerGPU L = uFields[idx].layers[i];

        int   type     = int(L.params0.w + 0.5);
        vec3  o        = L.origin.xyz;
        vec3  dir      = L.direction.xyz;
        float strength = L.params0.x;
        float radius   = L.params0.y;
        float falloff  = L.params0.z;
        float nScale   = L.params1.x;
        float nSpeed   = L.params1.y;

        if (type == FT_VISCOSITY) {
            outTotalVisc += strength;
            continue;
        }
        if (type == FT_RECEIVER_PLANE) {
            continue;
        }

        float atten = 1.0;
        vec3  acc   = vec3(0.0);

        if (type != FT_RADIAL_AXIS && type != FT_VORTEX_AXIS) {
            atten = calcAttenuation(o, radius, falloff, pos);
            if (atten <= 0.0) continue;
        }

        if (type == FT_GRAVITY_DIR) {
            acc = dir * strength;

        } else if (type == FT_GRAVITY_POINT) {
            vec3 toOrigin = o - pos;
            float distSq = dot(toOrigin, toOrigin);
            if (distSq >= 1e-4) {
                float invDist = inversesqrt(distSq);
                float dist = distSq * invDist;
                acc = (toOrigin * invDist) * (strength / (dist + 1.0));
            }

        } else if (type == FT_VORTEX) {
            float dirLenSq = dot(dir, dir);
            if (dirLenSq >= 1e-6) {
                vec3 axis = dir * inversesqrt(dirLenSq);
                vec3 toPos = pos - o;
                vec3 radial = toPos - axis * dot(toPos, axis);
                float distSq = dot(radial, radial);
                if (distSq >= 1e-6) {
                    float invDist = inversesqrt(distSq);
                    float dist = distSq * invDist;
                    // Vì axis là vector đơn vị và vuông góc với radial, |cross(axis, radial)| == dist.
                    vec3 tangent = cross(axis, radial) * invDist;
                    acc = tangent * (strength / (dist + 1.0));
                }
            }

        } else if (type == FT_WIND) {
            float t = time * nSpeed;
            vec3 scaledPos = pos * nScale;
            float nx = fieldNoiseScalar(vec3(scaledPos.x + t, scaledPos.y, scaledPos.z));
            float nz = fieldNoiseScalar(vec3(scaledPos.x + 53.9, scaledPos.y, scaledPos.z + t));
            acc = dir * strength + vec3(nx, 0.0, nz) * (strength * 0.35);

        } else if (type == FT_NOISE_PERLIN) {
            float t = time * nSpeed;
            vec3 scaledPos = pos * nScale;
            float nx = fieldNoiseScalar(vec3(scaledPos.x + t,    scaledPos.y + 17.7, scaledPos.z + 17.7));
            float ny = fieldNoiseScalar(vec3(scaledPos.x + 37.3, scaledPos.y + t,    scaledPos.z + 37.3));
            float nz = fieldNoiseScalar(vec3(scaledPos.x + 73.1, scaledPos.y + 73.1, scaledPos.z + t));
            acc = vec3(nx, ny, nz) * strength;

        } else if (type == FT_NOISE_CURL) {
            float t = time * nSpeed;
            vec3 scaledPos = pos * nScale;
            vec3 p = vec3(scaledPos.x + t, scaledPos.y, scaledPos.z + t);
            acc = fieldCurlNoise(p) * strength;

        } else if (type == FT_DRAG) {
            acc = -strength * vel;

        } else if (type == FT_RADIAL_AXIS || type == FT_VORTEX_AXIS) {
            float dirLenSq = dot(dir, dir);
            if (dirLenSq >= 1e-6) {
                // Chuẩn hóa trục trước khi chiếu để khoảng cách vuông góc chính xác với mọi vector dir
                vec3 axis = dir * inversesqrt(dirLenSq);
                vec3 toPoint = pos - o;
                float alongAxis = dot(toPoint, axis);
                vec3 closestOnAxis = o + axis * alongAxis;
                vec3 radialVec = pos - closestOnAxis;
                float perpDistSq = dot(radialVec, radialVec);
                bool outOfRadius = (radius > 0.0 && perpDistSq >= radius * radius);
                if (!outOfRadius && perpDistSq >= 1e-6) {
                    float invPerpDist = inversesqrt(perpDistSq);
                    float perpDist = perpDistSq * invPerpDist;
                    if (radius <= 0.0) {
                        atten = 1.0;
                    } else {
                        float tt = perpDist / radius;
                        if (falloff <= 0.0) atten = 1.0;
                        else if (falloff <= 1.0) atten = 1.0 - tt;
                        else {
                            float omt = 1.0 - tt;
                            atten = omt * omt;
                        }
                    }
                    if (type == FT_RADIAL_AXIS) {
                        acc = (radialVec * (-invPerpDist)) * strength;
                    } else {
                        vec3 tangent = cross(axis, radialVec) * invPerpDist;
                        acc = tangent * (strength / (perpDist + 1.0));
                    }
                }
            }

        } else if (type == FT_VECTOR_TEXTURE) {
            vec2 halfExtent = dir.xz;
            if (halfExtent.x > 1e-4 && halfExtent.y > 1e-4) {
                vec2 uv = (pos.xz - o.xz) / (2.0 * halfExtent) + 0.5;
                if (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0) {
                    int slot = int(nScale + 0.5);
                    vec4 texel = (slot == 1) ? textureLod(uVectorField1, uv, 0.0)
                                              : textureLod(uVectorField0, uv, 0.0);
                    vec2 flow = texel.rg * 2.0 - 1.0;
                    acc = vec3(flow.x, 0.0, flow.y) * strength;
                }
            }
        }

        totalAcc += acc * atten;
    }
    return totalAcc;
}

float segmentDistanceSq(vec3 a, vec3 b, vec3 point) {
    vec3 ab = b - a;
    float denom = dot(ab, ab);
    float t = denom > 1e-8 ? clamp(dot(point - a, ab) / denom, 0.0, 1.0) : 0.0;
    vec3 delta = a + ab * t - point;
    return dot(delta, delta);
}

vec3 computeTransportedOffset(int pathIndex, int waypoint, int finalIndex, vec3 formationOffset) {
    if (dot(formationOffset, formationOffset) <= 1e-10) {
        return vec3(0.0);
    }
    vec3 origin = uTravelPaths[pathIndex].formation_origin.xyz;
    vec3 fromDelta = uTravelPaths[pathIndex].points[0].xyz - origin;
    float fromLenSq = dot(fromDelta, fromDelta);
    if (fromLenSq <= 1e-8) {
        return formationOffset;
    }
    vec3 baseA = (waypoint > 0) ? uTravelPaths[pathIndex].points[waypoint - 1].xyz : origin;
    vec3 baseB = uTravelPaths[pathIndex].points[min(waypoint, finalIndex)].xyz;
    vec3 toDelta = baseB - baseA;
    float toLenSq = dot(toDelta, toDelta);
    if (toLenSq <= 1e-8) {
        return formationOffset;
    }

    vec3 fromT = fromDelta * inversesqrt(fromLenSq);
    vec3 toT = toDelta * inversesqrt(toLenSq);
    vec3 rotAxis = cross(fromT, toT);
    float rotSinSq = dot(rotAxis, rotAxis);
    float rotCos = clamp(dot(fromT, toT), -1.0, 1.0);
    if (rotSinSq > 1e-10) {
        float invSin = inversesqrt(rotSinSq);
        float rotSin = rotSinSq * invSin;
        rotAxis *= invSin;
        return formationOffset * rotCos +
               cross(rotAxis, formationOffset) * rotSin +
               rotAxis * dot(rotAxis, formationOffset) * (1.0 - rotCos);
    } else if (rotCos < 0.0) {
        return -formationOffset;
    }
    return formationOffset;
}

// Mirrors ParticleTravel_Step. Force and drag have already modified `vel`;
// finite steering guides that result instead of erasing field deflection.
bool evalTravelPath(int pathIndex, inout vec3 pos, inout vec3 vel,
                    inout float waypointValue, float dt, vec3 formationOffset) {
    if (pathIndex < 0 || pathIndex >= MAX_GPU_TRAVEL_PATHS) return false;
    int count = clamp(int(uTravelPaths[pathIndex].params.x + 0.5),
                      0, TRAVEL_MAX_WAYPOINTS);
    if (count <= 0) return false;
    int finalIndex = count - 1;
    int waypoint = clamp(int(waypointValue + 0.5), 0, finalIndex);

    vec3 transportedOffset = computeTransportedOffset(pathIndex, waypoint, finalIndex, formationOffset);

    float waypointRadius = uTravelPaths[pathIndex].radii.x > 0.0
                               ? uTravelPaths[pathIndex].radii.x : 0.10;
    float targetRadius = uTravelPaths[pathIndex].radii.y > 0.0
                             ? uTravelPaths[pathIndex].radii.y : waypointRadius;
    float waypointRadiusSq = waypointRadius * waypointRadius;

    for (int i = 0; i < TRAVEL_MAX_WAYPOINTS - 1; ++i) {
        if (waypoint >= finalIndex) break;
        vec3 occupiedGoal = uTravelPaths[pathIndex].points[waypoint].xyz + transportedOffset;
        vec3 occupiedDelta = pos - occupiedGoal;
        if (dot(occupiedDelta, occupiedDelta) > waypointRadiusSq)
            break;
        waypoint++;
        transportedOffset = computeTransportedOffset(pathIndex, waypoint, finalIndex, formationOffset);
    }

    vec3 goal = uTravelPaths[pathIndex].points[waypoint].xyz + transportedOffset;
    vec3 toGoal = goal - pos;
    float distSq = dot(toGoal, toGoal);
    float speed = uTravelPaths[pathIndex].params.y;
    if (speed <= 0.0) {
        float velSq = dot(vel, vel);
        speed = (velSq > 1e-8) ? sqrt(velSq) : 1.0;
    }
    vec3 desired = (distSq > 1e-10) ? (toGoal * (speed * inversesqrt(distSq)))
                                    : vec3(0.0);
    float steering = uTravelPaths[pathIndex].params.z > 0.0
                         ? uTravelPaths[pathIndex].params.z : 8.0;
    vec3 velocityDelta = (desired - vel) * (1.0 - exp(-steering * dt));
    float maxAcceleration = uTravelPaths[pathIndex].params.w;
    if (maxAcceleration > 0.0) {
        float maxDelta = maxAcceleration * dt;
        float changeSq = dot(velocityDelta, velocityDelta);
        if (changeSq > maxDelta * maxDelta && changeSq > 1e-12) {
            velocityDelta *= maxDelta * inversesqrt(changeSq);
        }
    }
    vel += velocityDelta;

    vec3 next = pos + vel * dt;
    float hitRadius = (waypoint == finalIndex) ? targetRadius : waypointRadius;
    if (segmentDistanceSq(pos, next, goal) <= hitRadius * hitRadius) {
        if (waypoint == finalIndex) {
            pos = goal;
            waypointValue = float(waypoint);
            return true;
        }
        waypoint++;
    }
    pos = next;
    waypointValue = float(waypoint);
    return false;
}

#include "core/motion/shaders/motion_wind.glsl"
#include "core/particles/shaders/gpu/particle_motion.glsl"

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(particles.length())) return;

    // TỐI ƯU BĂNG THÔNG SSBO: Chỉ đọc 16 bytes (life_data) trước để kiểm tra hạt còn sống không.
    // Tránh nạp lãng phí toàn bộ 144 bytes (9 vec4) cho các slot trống hoặc vừa hết hạn!
    vec4 life = particles[idx].life_data;
    if (life.w < 0.5) return;

    life.x -= u_dt;
    if (life.x <= 0.0) {
        particles[idx].life_data = vec4(life.x, life.y, life.z, 0.0);
        return;
    }

    GpuParticleData p = particles[idx];
    p.life_data = life;

    int forceIndex = int(p.ff_data.x);
    bool isMotionBody = (idx < uint(motionBodies.length()) && motionBodies[idx].meta.x != 0u);

    if (isMotionBody) {
        motionPhysicalNoise = true;
        motionIntegrate(idx, p);
    } else {
        int pathIndex = int(p.route_data.z);
        bool impactActive = p.impact_data.y > 0.5;
        if (impactActive) {
            p.impact_data.x += u_dt;
            if (pathIndex >= 0 && pathIndex < MAX_GPU_TRAVEL_PATHS &&
                (uTravelPaths[pathIndex].radii.z <= 0.0 ||
                 p.impact_data.x <= uTravelPaths[pathIndex].radii.z)) {
                forceIndex = int(uTravelPaths[pathIndex].arrival.x + 0.5);
            } else {
                forceIndex = -1;
            }
        }

        float totalVisc = 0.0;
        vec3 ffAccel = evalForceField(forceIndex, p.pos_radius.xyz, p.vel_drag.xyz, u_time, totalVisc);
        p.vel_drag.xyz += ffAccel * u_dt;

        if (totalVisc > 0.0) {
            p.vel_drag.xyz *= exp(-totalVisc * u_dt);
        }

        if (p.vel_drag.w > 0.0) {
            float drag_factor = max(1.0 - p.vel_drag.w * u_dt, 0.0);
            p.vel_drag.xyz *= drag_factor;
        }

        bool reachedTarget = false;
        if (pathIndex >= 0 && !impactActive) {
            reachedTarget = evalTravelPath(pathIndex, p.pos_radius.xyz,
                                           p.vel_drag.xyz, p.route_data.w, u_dt,
                                           p.formation_data.xyz);
        } else {
            // Hạt thông thường hoặc hạt đã tới đích (impactActive): chỉ lấy mẫu gió khi windInf > 0.0
            float windInf = p.impact_data.z;
            if (windInf > 0.0) {
                float fIdx = float(idx);
                float h1 = fract(sin(fIdx * 127.1) * 43758.5453);
                float h2 = fract(sin(fIdx * 269.5) * 43758.5453);
                float h3 = fract(sin(fIdx * 419.2) * 43758.5453);
                vec3 samplePos = p.pos_radius.xyz + vec3(h1 - 0.5, h2 - 0.5, h3 - 0.5) * 3.0;
                vec3 windVel = evalWindVelocity(samplePos, u_time);
                float blendRate = (1.0 - exp(-3.5 * u_dt)) * windInf;
                p.vel_drag.xyz += (windVel - p.vel_drag.xyz) * blendRate;
            }
            p.pos_radius.xyz += p.vel_drag.xyz * u_dt;
        }

        if (reachedTarget) {
            if (pathIndex >= 0 && pathIndex < MAX_GPU_TRAVEL_PATHS &&
                uTravelPaths[pathIndex].arrival.x >= -0.5) {
                int ptCount = int(uTravelPaths[pathIndex].params.x + 0.5);
                vec3 targetPos = ptCount > 0 ? uTravelPaths[pathIndex].points[ptCount - 1].xyz : p.pos_radius.xyz;
                vec3 radial = p.pos_radius.xyz - targetPos;
                float radialSq = dot(radial, radial);
                float velSq = dot(p.vel_drag.xyz, p.vel_drag.xyz);
                vec3 outward = (radialSq > 1e-8)
                    ? (radial * inversesqrt(radialSq))
                    : ((velSq > 1e-8) ? (p.vel_drag.xyz * inversesqrt(velSq)) : vec3(0.0, 1.0, 0.0));
                if (dot(outward, outward) < 1e-6) outward = vec3(1.0, 0.0, 0.0);

                if (uTravelPaths[pathIndex].arrival.w > 0.0)
                    p.vel_drag.xyz *= uTravelPaths[pathIndex].arrival.w;
                if (uTravelPaths[pathIndex].arrival.y > 0.0)
                    p.pos_radius.xyz += outward * uTravelPaths[pathIndex].arrival.y;
                if (uTravelPaths[pathIndex].arrival.z != 0.0)
                    p.vel_drag.xyz += outward * uTravelPaths[pathIndex].arrival.z;

                p.impact_data.x = 0.0;
                p.impact_data.y = 1.0;
            } else {
                particles[idx].life_data = vec4(p.life_data.x, p.life_data.y, p.life_data.z, 0.0);
                return;
            }
        }
    }

    // Same receiver contract as ParticlePlane_Resolve on both CPU paths.
    if (forceIndex >= 0 && forceIndex < int(uFields.length())) {
        int count = clamp(uFields[forceIndex].meta.x, 0, FF_MAX_LAYERS);
        for (int i = 0; i < count; ++i) {
            ForceLayerGPU layer = uFields[forceIndex].layers[i];
            if (int(layer.params0.w + 0.5) != FT_RECEIVER_PLANE) continue;
            float normalLenSq = dot(layer.direction.xyz, layer.direction.xyz);
            if (normalLenSq < 1e-12) continue;
            vec3 normal = layer.direction.xyz * inversesqrt(normalLenSq);
            float distance = dot(p.pos_radius.xyz - layer.origin.xyz, normal);
            float radius = max(p.pos_radius.w, 0.0);
            if (distance >= radius) continue;
            p.pos_radius.xyz += normal * (radius - distance);
            float speed = dot(p.vel_drag.xyz, normal);
            if (speed < 0.0) {
                float bounce = -speed * clamp(layer.params0.x, 0.0, 1.0);
                float retain = clamp(layer.params0.z, 0.0, 1.0);
                p.vel_drag.xyz = (p.vel_drag.xyz - normal * speed) * retain + normal * bounce;
            }
        }
    }

    // Ground / Terrain Collision Y-bounce
    float elasticity = p.ff_data.z; // ff_pad1
    if (elasticity >= 0.0) {
        float floorY = p.ff_data.w; // ff_pad2
        float terrainY = 0.0;
        if (sampleTerrainHeight(p.pos_radius.xz, terrainY)) {
            floorY = max(floorY, terrainY);
        }
        if (p.pos_radius.y <= floorY) {
            if (p.vel_drag.y < 0.0) {
                p.vel_drag.y = -p.vel_drag.y * elasticity;
            }
            p.vel_drag.xz *= isMotionBody ? 0.75 : 0.8;
            p.pos_radius.y = floorY + 0.005;
        }
    }

    // Chỉ ghi lại đúng 5 vec4 có thay đổi (80 bytes) thay vì ghi đè cả 9 vec4 (144 bytes)
    particles[idx].pos_radius  = p.pos_radius;
    particles[idx].vel_drag    = p.vel_drag;
    particles[idx].life_data   = p.life_data;
    particles[idx].route_data  = p.route_data;
    particles[idx].impact_data = p.impact_data;
}
