{
  "_comment": "F0 purge, 28/07/2026: every composition predating the Đợt E/F rebuild was deleted, plus the two spirit components. This manifest lists the survivors. Add a new VFX by hand here FIRST, then run scripts/sync_vfx_test.py.",
  "_placeholders": {
    "$POS": "s_prefabStartPos  (VFX spawn origin)",
    "$TIME": "s_meshTime        (running time for continuous effects)",
    "$PROG": "progress          (fminf(s_meshTime/1.0f, 1.0f), pre-computed in draw block)",
    "$SEED": "posSeed           (position-derived int seed, pre-computed in draw block)"
  },
  "_categories": [
    "fire",
    "water",
    "wood",
    "metal",
    "earth",
    "taiji",
    "util"
  ],
  "excluded": {
    "_comment": "Functions intentionally NOT in NEWFX — complex lifecycle or test-harness-only",
    "lifecycle": [
      "VFX_AttachQiAura",
      "VFX_DetachQiAura",
      "VFX_UpdateQiAuras",
      "VFX_Compose_Update",
      "VFX_Compose_Draw3D",
