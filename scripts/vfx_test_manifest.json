{
  "_comment": "Source of truth for NEWFX tab in sandbox/vfx_test.c. Edit here, then run: python3 scripts/sync_vfx_test.py",
  "_placeholders": {
    "$POS":  "s_prefabStartPos  (VFX spawn origin)",
    "$TIME": "s_meshTime        (running time for continuous effects)",
    "$PROG": "progress          (fminf(s_meshTime/1.0f, 1.0f), pre-computed in draw block)",
    "$SEED": "posSeed           (position-derived int seed, pre-computed in draw block)"
  },
  "excluded": {
    "_comment": "Functions intentionally NOT in NEWFX — covered by other tabs or lifecycle-only",
    "other_tabs": [
      "VFX_ComposeSmokePuff",
      "VFX_ComposeSmokeTrail",
      "VFX_ComposeFissureStreak",
      "VFX_ComposeLightningBolt",
      "VFX_ComposeImpact",
      "VFX_ComposeCast",
      "VFX_ComposeProjectileTrail",
      "VFX_ComposeTriggerImpactBurst",
      "VFX_ComposeStonePillar",
      "VFX_ComposeBoulder",
      "VFX_ComposeIceCrystal",
      "VFX_ComposeMagicPuddle",
      "VFX_ComposeFireball",
      "VFX_ComposeProjectile"
    ],
    "lifecycle": [
      "VFX_AttachQiAura",
      "VFX_DetachQiAura",
      "VFX_UpdateQiAuras"
    ],
    "deferred": {
      "_comment": "In header but needs non-trivial test setup — add to entries when ready",
      "VFX_ComposeWaterStream":  "needs 4 control points",
      "VFX_ComposeGlowingVine":  "needs branch geometry",
      "VFX_GroundPattern":       "needs GroundPatternStyle enum choice",
      "VFX_PathWave":            "needs points array",
      "VFX_SummonCircle":        "todo",
      "VFX_TriggerExplosion":    "todo",
      "VFX_ComposeAura":         "todo",
      "VFX_ComposeBeam":         "todo",
      "VFX_ComposeQiAura":       "todo"
    }
  },
