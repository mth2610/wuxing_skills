{
  "_comment": "Source of truth for NEWFX tab in sandbox/vfx_test.c. Edit here, then run: python3 scripts/sync_vfx_test.py",
  "_placeholders": {
    "$POS": "s_prefabStartPos  (VFX spawn origin)",
    "$TIME": "s_meshTime        (running time for continuous effects)",
    "$PROG": "progress          (fminf(s_meshTime/1.0f, 1.0f), pre-computed in draw block)",
    "$SEED": "posSeed           (position-derived int seed, pre-computed in draw block)"
  },
  "_categories": [
    "fire",
    "water",
    "wood",
    "metal",
    "earth",
    "taiji",
    "util"
  ],
  "excluded": {
    "_comment": "Functions intentionally NOT in NEWFX — complex lifecycle or test-harness-only",
    "lifecycle": [
      "VFX_AttachQiAura",
      "VFX_DetachQiAura",
      "VFX_UpdateQiAuras",
      "VFX_Compose_Update",
      "VFX_Compose_Draw3D",
      "VFX_KillProcBeam",
      "VFX_KillAuraRing",
      "VFX_KillSmokeColumn",
      "VFX_SpawnMeshElectricity",
      "VFX_UpdateMeshElectricity",
      "VFX_KillMeshElectricity",
      "VFX_BeginEnergySmokeBatch",
      "VFX_EndEnergySmokeBatch",
      "VFX_BeginMagicFilamentsBatch",
      "VFX_EndMagicFilamentsBatch",
      "VFX_BeginSmokeColumnBatch",
      "VFX_EndSmokeColumnBatch",
      "VFX_BeginWaterStreams",
      "VFX_EndWaterStreams",
      "VFX_AuraSetIntensity",
      "VFX_KillCharacterAura"
    ],
    "complex_multi_arg": [
      "VFX_ComposeTriggerImpactBurst",
      "VFX_ChainLightning",
      "VFX_ComposePathMistWave",
      "VFX_PathWave",
      "VFX_ComposePathLink",
      "VFX_DrawWaterStreamOnPath"
    ]
  },
  "exclude_from_auto_include": {
    "common": [
      "vc_proc_beam.inl",
      "vc_ground_wave.inl",
      "vc_orbital.inl",
      "vc_aura_ring.inl",
      "vc_chain_lightning.inl",
      "vc_smoke_column.inl",
      "vc_shard_debris.inl",
      "vc_crown_splash.inl",
      "vc_mesh_electricity.inl",
      "vc_particle_upgrades_test.inl",
      "vc_trail_upgrades_test.inl",
      "vc_trail_ribbon_test.inl",
      "vc_character_aura.inl"
    ]
  },
