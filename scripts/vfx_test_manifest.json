      "fn": "VFX_ComposeCoreGlow",
      "label": "CORE GLOW",
      "category": "common",
      "type": "continuous",
      "_comment": "PRIMARY, extracted from ChargeConverge. Immediate-mode: called every frame while the glow should exist. intensity01 is swept 0->1 over the play window so the bench shows the whole range in one trigger rather than one point of it.",
      "draw_block": [
        "{",
        "float i01 = $TIME / 2.5f; if (i01 > 1.0f) i01 = 1.0f;",
        "VFX_ComposeCoreGlow(Vector3Add($POS, (Vector3){-2.2f, 1.4f, 0.0f}), VC_MAT_FIRE, 1.0f, i01);",
