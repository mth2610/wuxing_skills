#version 430

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer TuftBounds {
    vec4 b_tufts[];
};

layout(std430, binding = 1) writeonly buffer VisibleIds {
    uint b_visibleIds[];
};

layout(std430, binding = 2) buffer IndirectCmds {
    uint b_cmds[];
};

uniform int   u_tuftCount;
uniform uint  u_bandStride;
uniform vec3  u_lodCam;
uniform vec4  u_lodBands;
uniform float u_drawDistSq;
uniform float u_fadeStartSq;
uniform vec4  u_frustumPlanes[6];

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (int(id) >= u_tuftCount)
        return;

    vec4 t = b_tufts[id];
    vec3 d = t.xyz - u_lodCam;
    vec3 hd = vec3(d.x, d.y * 0.35, d.z);
    float rawDist = sqrt(dot(hd, hd));
    float macroNoise = sin(t.x * 0.085 + t.z * 0.062) * 0.55 +
                       cos(t.z * 0.125 - t.x * 0.071 + 1.4) * 0.45;
    float dist = max(0.0, rawDist * (1.0 + macroNoise * 0.14));
    float distSq = dist * dist;

    uint hx = floatBitsToUint(t.x);
    uint hz = floatBitsToUint(t.z);
    uint h = (hx * 0x8da6b343u) ^ (hz * 0xd8163841u);
    h ^= h >> 16; h *= 0x7feb352du; h ^= h >> 15; h *= 0x846ca68bu; h ^= h >> 16;
    float hashRank = float(h & 0x00ffffffu) * (1.0 / 16777216.0);
    float ign = fract(52.9829189 * fract(0.06711056 * t.x + 0.00583715 * t.z));
    float rank = fract(hashRank * 0.65 + ign * 0.35);

    if (u_drawDistSq > 0.0) {
        if (distSq > u_drawDistSq)
            return;
        float fadeStartSq = (u_fadeStartSq > 0.0) ? u_fadeStartSq : (u_drawDistSq * 0.4624);
        if (distSq > fadeStartSq) {
            float thinT = clamp((distSq - fadeStartSq) / max(u_drawDistSq - fadeStartSq, 1.0), 0.0, 1.0);
            float keepProb = pow(max(1.0 - thinT, 0.0), 1.20);
            if (rank > keepProb)
                return;
        }
    }

    for (int p = 0; p < 6; p++) {
        if (dot(u_frustumPlanes[p].xyz, t.xyz) + u_frustumPlanes[p].w < -t.w)
            return;
    }

    // u_lodBands = (midDist, lodDist, nearBlend, farBlend)
    int lod = 0;
    if (u_lodBands.y > 0.0) {
        float farWeight = smoothstep(u_lodBands.y - u_lodBands.w,
                                     u_lodBands.y + u_lodBands.w, dist);
        if (rank < farWeight) {
            lod = 2;
        } else if (u_lodBands.x > 0.0) {
            float midWeight = smoothstep(u_lodBands.x - u_lodBands.z,
                                         u_lodBands.x + u_lodBands.z, dist);
            lod = (rank < midWeight) ? 1 : 0;
        }
    }

    uint slot = atomicAdd(b_cmds[lod * 5 + 1], 1u);
    b_visibleIds[uint(lod) * u_bandStride + slot] = id;
}
